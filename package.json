    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-vite": "^5.0.0",
    "typescript": "~6.0.3",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.0",
